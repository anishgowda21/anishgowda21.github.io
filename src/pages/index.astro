---
import "../styles/global.css";

const title = "Anish Gowda";
const description = "A little corner of the internet belonging to Anish Gowda.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="min-h-screen bg-neutral-950 font-mono text-neutral-100">
    <main
      class="mx-auto flex min-h-screen w-full max-w-2xl flex-col justify-center px-6 py-16"
    >
      <p class="text-sm text-neutral-500">A LITTLE CORNER OF THE INTERNET</p>
      <h1 class="mt-6 text-3xl font-medium tracking-tight sm:text-4xl">
        Hi, I’m Anish Gowda.
      </h1>
      <p class="mt-4 max-w-lg text-base leading-7 text-neutral-400">
        I’m interested in technology, the web, and learning by making things.
      </p>
      <a
        class="mt-8 w-fit text-sm text-neutral-200 underline decoration-neutral-600 underline-offset-4 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-400"
        href="https://github.com/anishgowda21"
      >
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </main>
  </body>
</html>
